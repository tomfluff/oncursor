# Copy to .env for local dev (never commit the real key).
# In production these are set as Cloud Run env vars / secrets.

# Optional: which provider to use. Default: openai.
LLM_PROVIDER=openai

# Required if LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-...
# Optional: vision model to use.
OPENAI_MODEL=gpt-4.1

# Required if LLM_PROVIDER=gemini.
GEMINI_API_KEY=...
# Optional: vision model to use.
GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated CORS allowlist (the demo's origin).
# Use "*" only for local testing.
ALLOWED_ORIGINS=https://visual-context.github.io

# Optional: max accepted image size in bytes (default 8 MB).
# MAX_IMAGE_BYTES=8388608

# Optional: enable debug mode (auto-reload, verbose logging).
DEBUG=false